# language-tidbits-engine environment configuration
# Copy this file to .env and fill in your values

# --- n8n ---
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678

# --- LLM API ---
# Used for script generation, fact checking, metadata
LLM_API_URL=http://localhost:8080/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL=claude-sonnet-4-6

# --- TTS ---
# Kokoro or Chatterbox endpoint
TTS_ENGINE=kokoro
TTS_API_URL=http://localhost:8880/v1/audio/speech
TTS_VOICE=af_heart
TTS_SAMPLE_RATE=24000

# --- Content queue ---
# google_sheets or baserow
CONTENT_QUEUE_TYPE=google_sheets
GOOGLE_SHEETS_ID=your-sheet-id-here
GOOGLE_SHEETS_CREDENTIALS_PATH=/path/to/credentials.json
# If using Baserow instead:
# BASEROW_API_URL=http://localhost:8000
# BASEROW_API_KEY=your-baserow-key-here
# BASEROW_TABLE_ID=your-table-id

# --- Paths ---
ASSETS_DIR=./assets
OUTPUT_DIR=./data/output
LOG_DIR=./data/logs
PROMPTS_DIR=./prompts

# --- FFmpeg ---
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# --- Video defaults ---
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30
VIDEO_CRF=23
FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf
FONT_SIZE=48
FONT_COLOR=white
CAPTION_BOX_COLOR=black@0.6

# --- Orshot (optional, for template-based image generation) ---
# ORSHOT_API_URL=http://localhost:3000
# ORSHOT_TEMPLATE_ID=language-tidbit-card

# --- Postgres (content pipeline) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=language_tidbits
POSTGRES_USER=tidbits
POSTGRES_PASSWORD=your-db-password-here

# --- Pipeline settings ---
BATCH_SIZE=5
